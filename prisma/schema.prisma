// RAYVEN - Premium Football Jersey & Athletic Brand
// Prisma Schema for PostgreSQL
// Fully Normalized Relational Database Architecture

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------
// ENUMS
// ----------------------------------------------------

enum RoleType {
  SUPER_ADMIN
  ADMIN
  MANAGER
  CASHIER
  CUSTOMER
}

enum OrderStatus {
  PENDING_PAYMENT
  CONFIRMED
  PACKED
  IN_HUB
  OUT_FOR_DELIVERY
  DELIVERED
  RETURNED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum PaymentGateway {
  BKASH
  NAGAD
  ROCKET
  CASH_ON_DELIVERY
  BANK_TRANSFER
  CARD
}

enum InventoryTransactionType {
  PURCHASE_RECEIPT
  ORDER_RESERVED
  ORDER_FULFILLED
  ORDER_CANCELLED_RELEASE
  CUSTOMER_RETURN
  EXCHANGE_OUT
  EXCHANGE_IN
  DAMAGED_WRITE_OFF
  LOST_WRITE_OFF
  MANUAL_ADJUSTMENT
}

enum CashTransactionType {
  DEBIT  // Money In / Inflow
  CREDIT // Money Out / Outflow
}

enum CashTransactionCategory {
  SALES_REVENUE
  PURCHASE_PAYMENT
  OPERATING_EXPENSE
  INVESTMENT_INFLOW
  WITHDRAWAL_OUTFLOW
  LOAN_RECEIPT
  LOAN_REPAYMENT
  RETURN_REFUND
  OTHER_ADJUSTMENT
}

enum LoanStatus {
  ACTIVE
  PAID_OFF
  DEFAULTED
  RESTRUCTURED
}

enum ReturnStatus {
  PENDING
  APPROVED
  RECEIVED
  REFUNDED
  REJECTED
}

enum ExchangeStatus {
  PENDING
  APPROVED
  DISPATCHED
  COMPLETED
  REJECTED
}

// ----------------------------------------------------
// 1. USER & AUTHENTICATION (Supports Multiple Admins)
// ----------------------------------------------------

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  passwordHash  String
  fullName      String
  phone         String?
  roleType      RoleType  @default(CUSTOMER)
  roleId        String?
  role          Role?     @relation(fields: [roleId], references: [id], onDelete: SetNull)
  avatarUrl     String?
  isActive      Boolean   @default(true)
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // 1-to-1 Extensions
  customer      Customer?
  admin         Admin?

  // General Relations
  addresses     Address[]
  notifications Notification[]
  activityLogs  ActivityLog[]

  @@index([email])
  @@index([roleType])
  @@index([roleId])
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique // e.g., "SUPER_ADMIN", "ADMIN", "INVENTORY_MANAGER", "FINANCE_OFFICER", "SUPPORT"
  description String?
  isSystem    Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  users       User[]
  permissions RolePermission[]

  @@index([name])
}

model Permission {
  id          String           @id @default(uuid())
  action      String           // "CREATE", "READ", "UPDATE", "DELETE", "APPROVE", "EXPORT"
  subject     String           // "PRODUCT", "ORDER", "PAYMENT", "INVENTORY", "FINANCE", "USER", "SYSTEM"
  code        String           @unique // e.g., "PAYMENT:APPROVE", "INVENTORY:ADJUST", "FINANCE:VIEW"
  description String?
  createdAt   DateTime         @default(now())

  roles       RolePermission[]

  @@index([code])
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

model Customer {
  id               String         @id @default(uuid())
  userId           String         @unique
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  customerCode     String         @unique // e.g., "CUST-2026-0001"
  isVerified       Boolean        @default(false) // Only verified customers should eventually be able to review products
  loyaltyPoints    Int            @default(0)
  totalSpent       Decimal        @db.Decimal(12, 2) @default(0.00)
  totalOrdersCount Int            @default(0)
  notes            String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  cart             Cart?
  wishlist         Wishlist?
  orders           Order[]
  reviews          Review[]
  savedAddresses   SavedAddress[]
  returns          Return[]
  exchanges        Exchange[]

  @@index([userId])
  @@index([customerCode])
  @@index([isVerified])
}

model Admin {
  id                 String                 @id @default(uuid())
  userId             String                 @unique
  user               User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  adminCode          String                 @unique // e.g., "ADM-001", "ADM-002"
  department         String?                // "Operations", "Finance", "Warehouse", "Management"
  isSuperAdmin       Boolean                @default(false)
  canApprovePayments Boolean                @default(false)
  canManageInventory Boolean                @default(true)
  canManageFinance   Boolean                @default(false)
  canManageUsers     Boolean                @default(false)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  activityLogs       ActivityLog[]
  paymentApprovals   PaymentStatusHistory[]
  managedPurchases   Purchase[]
  approvedReturns    Return[]
  recordedExpenses   Expense[]
  managedInvestments Investment[]
  managedLoans       Loan[]
  cashTransactions   CashTransaction[]
  recycleBinItems    RecycleBin[]

  @@index([userId])
  @@index([adminCode])
}

// ----------------------------------------------------
// 2. PRODUCTS & ATTRIBUTES
// ----------------------------------------------------

model Category {
  id          String     @id @default(uuid())
  slug        String     @unique
  name        String
  description String?
  imageUrl    String?
  isActive    Boolean    @default(true)
  parentId    String?
  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[] @relation("CategoryHierarchy")
  products    Product[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([slug])
  @@index([parentId])
}

model Club {
  id             String    @id @default(uuid())
  slug           String    @unique
  name           String
  shortCode      String    // e.g. "RMA", "ARS", "BAR", "MUN"
  league         String    // "Premier League", "La Liga", "Serie A", "International"
  country        String
  crestUrl       String?
  primaryColor   String?
  secondaryColor String?
  products       Product[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([slug])
  @@index([league])
}

model Season {
  id        String    @id @default(uuid())
  code      String    @unique // e.g. "2024-25", "2023-24", "1998-99"
  name      String    // e.g. "2024/25 Season", "Retro 1998 Classic"
  isCurrent Boolean   @default(false)
  startDate DateTime?
  endDate   DateTime?
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([code])
  @@index([isCurrent])
}

model Size {
  id           String           @id @default(uuid())
  code         String           @unique // "XS", "S", "M", "L", "XL", "2XL", "3XL"
  label        String           // "Extra Small", "Small", "Medium", "Large", "Extra Large", "2X Large"
  sortOrder    Int              @default(0)
  chestInches  Decimal?         @db.Decimal(5, 2)
  lengthInches Decimal?         @db.Decimal(5, 2)
  variants     ProductVariant[]
  inventories  Inventory[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([code])
  @@index([sortOrder])
}

model Product {
  id               String           @id @default(uuid())
  slug             String           @unique
  sku              String           @unique
  title            String
  subtitle         String?
  description      String
  details          String?          // Fabric, heat-pressed tech, washing instructions
  kitType          String?          // "Home", "Away", "Third", "Goalkeeper", "Retro", "Special Edition"
  baseSellingPrice Decimal          @db.Decimal(10, 2)
  baseBuyingPrice  Decimal          @db.Decimal(10, 2)
  comparePrice     Decimal?         @db.Decimal(10, 2)
  isFeatured       Boolean          @default(false)
  isNewArrival     Boolean          @default(false)
  isArchived       Boolean          @default(false)

  categoryId       String
  category         Category         @relation(fields: [categoryId], references: [id])
  clubId           String?
  club             Club?            @relation(fields: [clubId], references: [id], onDelete: SetNull)
  seasonId         String?
  season           Season?          @relation(fields: [seasonId], references: [id], onDelete: SetNull)

  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  images           ProductImage[]
  variants         ProductVariant[]
  cartItems        CartItem[]
  wishlistItems    WishlistItem[]
  reviews          Review[]
  inventories      Inventory[]

  @@index([slug])
  @@index([sku])
  @@index([categoryId])
  @@index([clubId])
  @@index([seasonId])
  @@index([isArchived])
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  altText   String?
  isPrimary Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([productId])
  @@index([isPrimary])
}

model ProductVariant {
  id                   String                 @id @default(uuid())
  productId            String
  product              Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  sizeId               String
  size                 Size                   @relation(fields: [sizeId], references: [id])
  sku                  String                 @unique // e.g. "RMA-2425-H-M"
  barcode              String?
  currentSellingPrice  Decimal                @db.Decimal(10, 2)
  currentBuyingPrice   Decimal                @db.Decimal(10, 2)
  compareAtPrice       Decimal?               @db.Decimal(10, 2)
  isActive             Boolean                @default(true)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  inventory            Inventory?
  priceHistories       VariantPriceHistory[]
  orderItems           OrderItem[]
  purchaseItems        PurchaseItem[]
  cartItems            CartItem[]
  inventoryMovements   InventoryTransaction[]
  returnItems          ReturnItem[]
  exchangeOriginals    Exchange[]             @relation("ExchangeOriginalVariant")
  exchangeReplacements Exchange[]             @relation("ExchangeReplacementVariant")

  @@unique([productId, sizeId])
  @@index([productId])
  @@index([sizeId])
  @@index([sku])
}

model VariantPriceHistory {
  id              String         @id @default(uuid())
  variantId       String
  variant         ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  sellingPrice    Decimal        @db.Decimal(10, 2)
  buyingPrice     Decimal        @db.Decimal(10, 2)
  effectiveDate   DateTime       @default(now())
  reason          String?        // "Initial price", "Supplier cost increase", "Promotional markdown"
  changedByUserId String?
  createdAt       DateTime       @default(now())

  @@index([variantId])
  @@index([effectiveDate])
}

// ----------------------------------------------------
// 3. SHOPPING (Cart & Wishlist)
// ----------------------------------------------------

model Cart {
  id             String     @id @default(uuid())
  customerId     String?    @unique
  customer       Customer?  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  guestSessionId String?    @unique
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  items          CartItem[]

  @@index([customerId])
  @@index([guestSessionId])
}

model CartItem {
  id           String         @id @default(uuid())
  cartId       String
  cart         Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId    String
  product      Product        @relation(fields: [productId], references: [id])
  variantId    String
  variant      ProductVariant @relation(fields: [variantId], references: [id])
  quantity     Int            @default(1)
  customName   String?        // Player/Customer Name Print
  customNumber String?        // Jersey Number Print
  customPatch  String?        // UCL, Premier League patch
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([cartId])
  @@index([productId])
  @@index([variantId])
}

model Wishlist {
  id         String         @id @default(uuid())
  customerId String         @unique
  customer   Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  items      WishlistItem[]

  @@index([customerId])
}

model WishlistItem {
  id         String   @id @default(uuid())
  wishlistId String
  wishlist   Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([wishlistId, productId])
  @@index([wishlistId])
  @@index([productId])
}

// ----------------------------------------------------
// 4. ORDER & ADDRESS
// ----------------------------------------------------

model Address {
  id             String         @id @default(uuid())
  userId         String?
  user           User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipientName  String
  phone          String
  streetAddress  String
  apartment      String?
  city           String         // Dhaka, Chittagong, Sylhet, etc.
  zone           String?        // Dhanmondi, Gulshan, Uttara, etc.
  postalCode     String?
  country        String         @default("Bangladesh")
  isDefault      Boolean        @default(false)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  ordersShipping Order[]        @relation("OrderShippingAddress")
  ordersBilling  Order[]        @relation("OrderBillingAddress")
  savedAddresses SavedAddress[]

  @@index([userId])
}

model SavedAddress {
  id         String   @id @default(uuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  addressId  String
  address    Address  @relation(fields: [addressId], references: [id], onDelete: Cascade)
  label      String   @default("Home") // "Home", "Office", "Other"
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([customerId])
  @@index([addressId])
}

model Order {
  id                String               @id @default(uuid())
  orderNumber       String               @unique // e.g. "RV-2026-9081"
  customerId        String?
  customer          Customer?            @relation(fields: [customerId], references: [id], onDelete: SetNull)
  guestEmail        String?
  guestPhone        String?
  shippingAddressId String
  shippingAddress   Address              @relation("OrderShippingAddress", fields: [shippingAddressId], references: [id])
  billingAddressId  String?
  billingAddress    Address?             @relation("OrderBillingAddress", fields: [billingAddressId], references: [id])

  orderStatus       OrderStatus          @default(PENDING_PAYMENT)
  paymentStatus     PaymentStatus        @default(PENDING)
  currency          String               @default("BDT")

  subtotal          Decimal              @db.Decimal(12, 2)
  shippingFee       Decimal              @db.Decimal(12, 2) @default(0.00)
  discountAmount    Decimal              @db.Decimal(12, 2) @default(0.00)
  totalAmount       Decimal              @db.Decimal(12, 2)

  courierPartner    String?              // "Steadfast", "Pathao", "RedX", "Paperfly"
  consignmentId     String?
  trackingNumber    String?
  customerNotes     String?
  adminNotes        String?

  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  items             OrderItem[]
  payments          Payment[]
  returns           Return[]
  exchanges         Exchange[]
  statusHistories   OrderStatusHistory[]

  @@index([orderNumber])
  @@index([customerId])
  @@index([orderStatus])
  @@index([paymentStatus])
  @@index([createdAt])
}

model OrderItem {
  id              String         @id @default(uuid())
  orderId         String
  order           Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId       String
  variant         ProductVariant @relation(fields: [variantId], references: [id])

  // Historical snapshot at the exact time the order was created
  productTitle    String
  sizeCode        String
  skuSnapshot     String
  unitPrice       Decimal        @db.Decimal(10, 2) // Selling price at purchase time
  unitBuyingPrice Decimal        @db.Decimal(10, 2) // Buying price at purchase time (for exact profit calculation)
  quantity        Int
  totalPrice      Decimal        @db.Decimal(10, 2)

  customName      String?
  customNumber    String?
  customPatch     String?
  createdAt       DateTime       @default(now())

  returnItems      ReturnItem[]
  exchangeOriginal Exchange[]     @relation("ExchangeOriginalOrderItem")

  @@index([orderId])
  @@index([variantId])
}

model OrderStatusHistory {
  id          String       @id @default(uuid())
  orderId     String
  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus  OrderStatus?
  toStatus    OrderStatus
  notes       String?
  changedById String?
  createdAt   DateTime     @default(now())

  @@index([orderId])
  @@index([toStatus])
}

// ----------------------------------------------------
// 5. PAYMENT & RECONCILIATION
// ----------------------------------------------------

model PaymentMethod {
  id               String              @id @default(uuid())
  code             String              @unique // "BKASH", "NAGAD", "ROCKET", "COD", "BANK"
  name             String              // "bKash Merchant / Personal", "Nagad", "Rocket", "Cash on Delivery"
  accountNumber    String?             // e.g. "017XXXXXXXX"
  accountType      String?             // "Merchant", "Personal", "Agent"
  instructions     String?             // Steps for customer on how to pay
  chargePercentage Decimal             @db.Decimal(5, 2) @default(0.00)
  isActive         Boolean             @default(true)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  payments         Payment[]
  submissions      PaymentSubmission[]

  @@index([code])
}

model Payment {
  id              String                 @id @default(uuid())
  paymentNumber   String                 @unique // e.g. "PAY-2026-0038"
  orderId         String
  order           Order                  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  paymentMethodId String?
  paymentMethod   PaymentMethod?         @relation(fields: [paymentMethodId], references: [id])
  gateway         PaymentGateway
  amount          Decimal                @db.Decimal(12, 2)
  currency        String                 @default("BDT")
  status          PaymentStatus          @default(PENDING)
  transactionId   String?                @unique // Prevent duplicate transaction IDs!
  notes           String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  submissions      PaymentSubmission[]
  statusHistories  PaymentStatusHistory[]
  cashTransactions CashTransaction[]

  @@index([orderId])
  @@index([status])
  @@index([transactionId])
}

model PaymentSubmission {
  id              String         @id @default(uuid())
  paymentId       String
  payment         Payment        @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  paymentMethodId String?
  paymentMethod   PaymentMethod? @relation(fields: [paymentMethodId], references: [id])
  gateway         PaymentGateway
  senderNumber    String         // e.g. "01812345678"
  transactionId   String         @unique // Prevent duplicate transaction IDs across submissions!
  amountSubmitted Decimal        @db.Decimal(12, 2)
  screenshotUrl   String?
  notes           String?
  status          PaymentStatus  @default(UNDER_REVIEW)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([paymentId])
  @@index([transactionId])
  @@index([senderNumber])
  @@index([status])
}

model PaymentStatusHistory {
  id               String         @id @default(uuid())
  paymentId        String
  payment          Payment        @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  fromStatus       PaymentStatus?
  toStatus         PaymentStatus
  changedByAdminId String?
  changedByAdmin   Admin?         @relation(fields: [changedByAdminId], references: [id])
  reason           String?
  createdAt        DateTime       @default(now())

  @@index([paymentId])
  @@index([changedByAdminId])
}

// ----------------------------------------------------
// 6. INVENTORY (Size-Aware, Normalized Tracking)
// ----------------------------------------------------

model Inventory {
  id                String         @id @default(uuid())
  productId         String
  product           Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId         String         @unique
  variant           ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  sizeId            String
  size              Size           @relation(fields: [sizeId], references: [id])

  // Size-aware stock buckets
  availableQuantity Int            @default(0)
  reservedQuantity  Int            @default(0)
  soldQuantity      Int            @default(0)
  returnedQuantity  Int            @default(0)
  damagedQuantity   Int            @default(0)
  lostQuantity      Int            @default(0)
  totalQuantity     Int            @default(0) // total physical = available + reserved + damaged + lost

  lowStockThreshold Int            @default(5)
  warehouseLocation String?        @default("Main Hub - Dhaka")
  lastRestockedAt   DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@unique([productId, sizeId])
  @@index([productId])
  @@index([sizeId])
  @@index([variantId])
}

model InventoryTransaction {
  id                String                   @id @default(uuid())
  variantId         String
  variant           ProductVariant           @relation(fields: [variantId], references: [id], onDelete: Cascade)
  transactionType   InventoryTransactionType
  quantityChange    Int                      // Positive (added) or negative (deducted)
  previousAvailable Int
  newAvailable      Int
  referenceType     String?                  // "ORDER", "PURCHASE", "RETURN", "EXCHANGE", "MANUAL"
  referenceId       String?
  notes             String?
  performedById     String?
  createdAt         DateTime                 @default(now())

  @@index([variantId])
  @@index([transactionType])
  @@index([referenceId])
  @@index([createdAt])
}

// ----------------------------------------------------
// 7. BUSINESS, PROCUREMENT & FINANCIAL OPERATIONS
// ----------------------------------------------------

model Supplier {
  id                  String         @id @default(uuid())
  code                String         @unique // e.g. "SUP-001"
  name                String
  contactPerson       String?
  phone               String?
  email               String?
  address             String?
  country             String         @default("Bangladesh")
  paymentTerms        String?        // "Net 30", "50% Advance", "Cash on Delivery"
  totalPurchasesCount Int            @default(0)
  totalPayable        Decimal        @db.Decimal(12, 2) @default(0.00)
  isActive            Boolean        @default(true)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  purchases           Purchase[]

  @@index([code])
}

model Purchase {
  id               String            @id @default(uuid())
  purchaseNumber   String            @unique // e.g. "PO-2026-0042"
  supplierId       String
  supplier         Supplier          @relation(fields: [supplierId], references: [id])
  status           String            @default("PENDING") // "PENDING", "RECEIVED", "CANCELLED"
  subtotal         Decimal           @db.Decimal(12, 2)
  shippingCost     Decimal           @db.Decimal(12, 2) @default(0.00)
  taxCost          Decimal           @db.Decimal(12, 2) @default(0.00)
  totalCost        Decimal           @db.Decimal(12, 2)
  paidAmount       Decimal           @db.Decimal(12, 2) @default(0.00)
  dueAmount        Decimal           @db.Decimal(12, 2) @default(0.00)
  orderedDate      DateTime          @default(now())
  receivedDate     DateTime?
  managedByAdminId String?
  managedByAdmin   Admin?            @relation(fields: [managedByAdminId], references: [id])
  notes            String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  items            PurchaseItem[]
  cashTransactions CashTransaction[]

  @@index([purchaseNumber])
  @@index([supplierId])
  @@index([status])
}

model PurchaseItem {
  id               String         @id @default(uuid())
  purchaseId       String
  purchase         Purchase       @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  variantId        String
  variant          ProductVariant @relation(fields: [variantId], references: [id])
  quantityOrdered  Int
  quantityReceived Int            @default(0)
  unitBuyingPrice  Decimal        @db.Decimal(10, 2)
  totalCost        Decimal        @db.Decimal(12, 2)
  createdAt        DateTime       @default(now())

  @@index([purchaseId])
  @@index([variantId])
}

model Return {
  id                String            @id @default(uuid())
  returnNumber      String            @unique // e.g. "RET-2026-0012"
  orderId           String
  order             Order             @relation(fields: [orderId], references: [id])
  customerId        String?
  customer          Customer?         @relation(fields: [customerId], references: [id])
  status            ReturnStatus      @default(PENDING)
  reason            String
  refundAmount      Decimal?          @db.Decimal(12, 2)
  refundMethod      String?           // "BKASH", "NAGAD", "STORE_CREDIT"
  approvedByAdminId String?
  approvedByAdmin   Admin?            @relation(fields: [approvedByAdminId], references: [id])
  requestedAt       DateTime          @default(now())
  resolvedAt        DateTime?
  notes             String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  items             ReturnItem[]
  cashTransactions  CashTransaction[]

  @@index([returnNumber])
  @@index([orderId])
  @@index([status])
}

model ReturnItem {
  id          String         @id @default(uuid())
  returnId    String
  return      Return         @relation(fields: [returnId], references: [id], onDelete: Cascade)
  orderItemId String
  orderItem   OrderItem      @relation(fields: [orderItemId], references: [id])
  variantId   String
  variant     ProductVariant @relation(fields: [variantId], references: [id])
  quantity    Int
  condition   String?        // "GOOD_RESTOCKABLE", "DEFECTIVE", "DAMAGED"
  restocked   Boolean        @default(false)
  createdAt   DateTime       @default(now())

  @@index([returnId])
  @@index([orderItemId])
  @@index([variantId])
}

model Exchange {
  id                   String         @id @default(uuid())
  exchangeNumber       String         @unique // e.g. "EXC-2026-0008"
  orderId              String
  order                Order          @relation(fields: [orderId], references: [id])
  customerId           String?
  customer             Customer?      @relation(fields: [customerId], references: [id])
  originalOrderItemId  String
  originalOrderItem    OrderItem      @relation("ExchangeOriginalOrderItem", fields: [originalOrderItemId], references: [id])
  originalVariantId    String
  originalVariant      ProductVariant @relation("ExchangeOriginalVariant", fields: [originalVariantId], references: [id])
  replacementVariantId String
  replacementVariant   ProductVariant @relation("ExchangeReplacementVariant", fields: [replacementVariantId], references: [id])
  quantity             Int            @default(1)
  priceDifference      Decimal        @db.Decimal(10, 2) @default(0.00) // positive: customer owes; negative: store owes
  status               ExchangeStatus @default(PENDING)
  reason               String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@index([exchangeNumber])
  @@index([orderId])
  @@index([status])
}

model Expense {
  id                String            @id @default(uuid())
  voucherNo         String            @unique // e.g. "EXP-2026-0089"
  category          String            // "Packaging", "Courier Logistics", "Salaries", "Office Rent", "Marketing", "Software"
  title             String
  amount            Decimal           @db.Decimal(12, 2)
  paidTo            String
  paidVia           String            // "bKash Merchant", "Cash", "Bank Transfer"
  receiptUrl        String?
  expenseDate       DateTime          @default(now())
  recordedByAdminId String?
  recordedByAdmin   Admin?            @relation(fields: [recordedByAdminId], references: [id])
  notes             String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  cashTransactions  CashTransaction[]

  @@index([voucherNo])
  @@index([category])
  @@index([expenseDate])
}

model Investment {
  id               String            @id @default(uuid())
  referenceNo      String            @unique // e.g. "INV-2026-001"
  investorName     String
  amount           Decimal           @db.Decimal(14, 2)
  equityShare      Decimal?          @db.Decimal(5, 2)
  terms            String?
  fundingDate      DateTime          @default(now())
  status           String            @default("ACTIVE") // "ACTIVE", "MATURED", "RETURNED"
  managedByAdminId String?
  managedByAdmin   Admin?            @relation(fields: [managedByAdminId], references: [id])
  notes            String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  cashTransactions CashTransaction[]

  @@index([referenceNo])
  @@index([status])
}

model Withdrawal {
  id               String            @id @default(uuid())
  withdrawalNumber String            @unique // e.g. "WTH-2026-002"
  partnerName      String
  amount           Decimal           @db.Decimal(14, 2)
  purpose          String?           // "Partner Profit Share", "Drawings", "Dividend"
  accountPaidFrom  String            // "Main Bank Account", "Petty Cash", "bKash Business"
  withdrawalDate   DateTime          @default(now())
  notes            String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  cashTransactions CashTransaction[]

  @@index([withdrawalNumber])
}

model CashTransaction {
  id                String                  @id @default(uuid())
  transactionNumber String                  @unique // e.g. "CTX-2026-0512"
  type              CashTransactionType     // DEBIT (Inflow) or CREDIT (Outflow)
  category          CashTransactionCategory
  amount            Decimal                 @db.Decimal(14, 2)
  accountName       String                  // "City Bank Operating", "bKash Merchant", "Nagad Merchant", "Petty Cash"
  description       String
  referenceType     String?                 // "ORDER_PAYMENT", "PURCHASE", "EXPENSE", "INVESTMENT", "WITHDRAWAL", "LOAN", "RETURN"
  referenceId       String?

  orderPaymentId    String?
  orderPayment      Payment?                @relation(fields: [orderPaymentId], references: [id])
  purchaseId        String?
  purchase          Purchase?               @relation(fields: [purchaseId], references: [id])
  expenseId         String?
  expense           Expense?                @relation(fields: [expenseId], references: [id])
  investmentId      String?
  investment        Investment?             @relation(fields: [investmentId], references: [id])
  withdrawalId      String?
  withdrawal        Withdrawal?             @relation(fields: [withdrawalId], references: [id])
  loanId            String?
  loan              Loan?                   @relation(fields: [loanId], references: [id])
  loanRepaymentId   String?
  loanRepayment     LoanRepayment?          @relation(fields: [loanRepaymentId], references: [id])
  returnId          String?
  returnRecord      Return?                 @relation(fields: [returnId], references: [id])

  recordedByAdminId String?
  recordedByAdmin   Admin?                  @relation(fields: [recordedByAdminId], references: [id])
  transactionDate   DateTime                @default(now())
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  @@index([transactionNumber])
  @@index([type])
  @@index([category])
  @@index([accountName])
  @@index([transactionDate])
}

model Loan {
  id               String            @id @default(uuid())
  loanNumber       String            @unique // e.g. "LN-2026-001"
  lenderName       String            // Bank / Financial Partner
  principal        Decimal           @db.Decimal(14, 2)
  interestRate     Decimal           @db.Decimal(5, 2) // Annual interest percentage
  termMonths       Int
  amountRepaid     Decimal           @db.Decimal(14, 2) @default(0.00)
  status           LoanStatus        @default(ACTIVE)
  disbursedDate    DateTime          @default(now())
  maturityDate     DateTime
  managedByAdminId String?
  managedByAdmin   Admin?            @relation(fields: [managedByAdminId], references: [id])
  notes            String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  repayments       LoanRepayment[]
  cashTransactions CashTransaction[]

  @@index([loanNumber])
  @@index([status])
}

model LoanRepayment {
  id              String            @id @default(uuid())
  repaymentNumber String            @unique // e.g. "LNR-2026-0012"
  loanId          String
  loan            Loan              @relation(fields: [loanId], references: [id], onDelete: Cascade)
  paymentAmount   Decimal           @db.Decimal(12, 2)
  principalPaid   Decimal           @db.Decimal(12, 2)
  interestPaid    Decimal           @db.Decimal(12, 2)
  repaymentDate   DateTime          @default(now())
  paymentMethod   String            // "Bank Transfer", "Cheque", "bKash"
  reference       String?
  notes           String?
  createdAt       DateTime          @default(now())

  cashTransactions CashTransaction[]

  @@index([loanId])
  @@index([repaymentNumber])
}

// ----------------------------------------------------
// 8. CUSTOMER INTERACTION (Review, Notifications)
// ----------------------------------------------------

model Review {
  id                 String    @id @default(uuid())
  productId          String
  product            Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  customerId         String
  customer           Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  rating             Int       // 1 to 5 stars
  headline           String?
  comment            String
  isVerifiedPurchase Boolean   @default(false) // Only verified customers should eventually be able to review products
  isApproved         Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([productId, customerId]) // One review per customer per product
  @@index([productId])
  @@index([customerId])
  @@index([isVerifiedPurchase])
}

model Notification {
  id        String    @id @default(uuid())
  userId    String?
  user      User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String    @default("INFO") // "INFO", "ORDER", "PAYMENT", "INVENTORY", "ALERT"
  linkUrl   String?
  isRead    Boolean   @default(false)
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([isRead])
  @@index([type])
}

// ----------------------------------------------------
// 9. ADMIN SYSTEM (ActivityLog, RecycleBin, Settings)
// ----------------------------------------------------

model ActivityLog {
  id        String   @id @default(uuid())
  adminId   String?
  admin     Admin?   @relation(fields: [adminId], references: [id], onDelete: SetNull)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String   // "PAYMENT_APPROVED", "ORDER_STATUS_CHANGED", "PRODUCT_CREATED", "INVENTORY_ADJUSTED", etc.
  entity    String   // "Payment", "Order", "Product", "Inventory", "Purchase", "Expense"
  entityId  String?
  ipAddress String?
  userAgent String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([adminId])
  @@index([userId])
  @@index([action])
  @@index([entity])
  @@index([createdAt])
}

model RecycleBin {
  id               String    @id @default(uuid())
  entityType       String    // "Product", "ProductVariant", "Supplier", "Purchase", "Expense"
  originalId       String
  name             String
  payload          Json      // Complete JSON snapshot for clean restoration
  deletedByAdminId String?
  deletedByAdmin   Admin?    @relation(fields: [deletedByAdminId], references: [id], onDelete: SetNull)
  deletedAt        DateTime  @default(now())
  purgeAfter       DateTime  // 30-day retention period
  isRestored       Boolean   @default(false)
  restoredAt       DateTime?

  @@index([entityType])
  @@index([deletedAt])
  @@index([isRestored])
}

model BusinessSettings {
  id          String   @id @default(uuid())
  key         String   @unique // e.g. "CURRENCY_DEFAULT", "VAT_PERCENTAGE", "ORDER_NOTIFICATION_EMAIL"
  value       String
  group       String   @default("GENERAL") // "GENERAL", "BRAND", "PAYMENT", "SHIPPING", "INVENTORY"
  description String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@index([key])
  @@index([group])
}
