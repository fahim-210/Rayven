# RAYVEN E-Commerce & ERP Environment Configuration

# Database (PostgreSQL / Prisma)
# PostgreSQL connection string for connection pooling (e.g. Supabase, Cloud SQL, Neon, RDS)
DATABASE_URL="postgresql://user:password@localhost:5432/rayven_db?schema=public&sslmode=prefer"
# Direct URL for Prisma migrations
DIRECT_URL="postgresql://user:password@localhost:5432/rayven_db?schema=public&sslmode=prefer"

# Authentication & Session Security
AUTH_SECRET="rayven-super-secure-random-32-byte-hex-secret-key"
JWT_SECRET="rayven-jwt-token-signing-secret"
ADMIN_REGISTRATION_KEY="rayven-secure-admin-bootstrap-token"

# Application Settings
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="RAYVEN"
NEXT_PUBLIC_CURRENCY_DEFAULT="USD"

# Payments & Gateway (Phase 02 integration ready)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# AI Studio runtime
GEMINI_API_KEY=""

